# OutLook Manager 服务地址
OUTLOOK_MANAGER_BASE_URL=https://outlook-manager.gpteamservices.com

# API Key（om_ 前缀，Web 管理台 /keys 页创建）—— 全能凭证，干一切：
# 取号 / 还号 / 状态上报 / 导入 / 列表 / 测活 / 清理 / Key 管理 / 统计
OUTLOOK_MANAGER_API_KEY=

# 管理员 JWT（可选，仅 Web 管理台场景用；scripts/outlook_manager.py login 获取，168 小时有效）
# OUTLOOK_MANAGER_ADMIN_JWT=
