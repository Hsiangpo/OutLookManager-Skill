# OutLook Manager 服务地址
OUTLOOK_MANAGER_BASE_URL=https://outlook-manager.gpteamservices.com

# 调用方 API Key（om_ 前缀，管理员在 Web /keys 页面创建）
# 用于：acquire / release / status / status-batch
OUTLOOK_MANAGER_API_KEY=

# 管理员 JWT（scripts/outlook_manager.py login 获取，有效期 168 小时）
# 用于：accounts / import / check / purge-expired / keys / stats
OUTLOOK_MANAGER_ADMIN_JWT=
